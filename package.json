{
  "name": "meridian-ats",
  "private": true,
  "version": "1.0.0",
  "description": "Meridian Technologies ATS MVP — DPDP-aware recruiting prototype",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently -n api,web -c blue,green \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test server/api.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
